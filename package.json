{
  "name": "multi-go-to-definitions",
  "displayName": "Multi Go To Definitions",
  "description": "Navigate and find definitions across multiple languages with ease.",
  "version": "1.0.0",
  "engines": {
    "vscode": "^1.0.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "main": "./src/app.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/juniormesquitadandao/multi_go_to_definitions"
  },
  "contributes": {
    "commands": [
      {
        "command": "extension.multiGoToDefinitions",
        "title": "Multi Go To Definitions"
      },
      {
        "command": "workbench.files.action.showActiveFileInExplorer",
        "title": "Reveal in Side Bar"
      },
      {
        "command": "revealFileInOS",
        "title": "Open Containing Folder"
      },
      {
      "command": "copyFilePath",
        "title": "Copy Path"
      },
      {
        "command": "copyRelativeFilePath",
        "title": "Copy Relative Path"
      }
    ],
    "keybindings": [
      {
        "command": "extension.multiGoToDefinitions",
        "key": "ctrl+f",
        "when": "editorTextFocus"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "workbench.files.action.showActiveFileInExplorer",
          "when": "editorTextFocus"
        },
        {
          "command": "revealFileInOS",
          "when": "editorTextFocus"
        },
        {
          "command": "copyFilePath",
          "when": "editorTextFocus"
        },
        {
          "command": "copyRelativeFilePath",
          "when": "editorTextFocus"
        }
      ]
    }
  },
  "scripts": {
    "test": "mocha",
    "build": "mkdir -p dist && vsce package -o dist/multi-go-to-definitions.vsix"
  },
  "devDependencies": {
    "chai": "^4.3.0",
    "child_process": "^1.0.2",
    "mocha": "^10.0.0",
    "sinon": "^15.0.0",
    "vsce": "^2.15.0",
    "vscode": "^1.0.0"
  }
}
